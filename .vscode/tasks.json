{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portfolio Dev Server",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "isBackground": true,
      "background": {
        "type": "standard",
        "beginsPattern": ".*VITE.*ready in.*",
        "endsPattern": ".*Local:.*http://127\\.0\\.0\\.1:5190/.*"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Starts Vite dev server on 127.0.0.1:5190 with strict port mode"
    },
    {
      "label": "Portfolio: Build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Portfolio: Type Check",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}